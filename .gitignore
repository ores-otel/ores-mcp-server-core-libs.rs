# Decrypted dotenv files are never committed.
/env/dec/**
!/env/dec/.gitkeep

# Only complete encrypted dotenv artifacts belong in this directory.
/env/enc/**
!/env/enc/.gitkeep
!/env/enc/*.env.enc

# Local Nix/direnv outputs.
/.direnv/
/result

