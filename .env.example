# Copy values into a secret manager or an untracked local .env file.
# Never commit real API keys.

OPENAI_API_KEY=
# Requested "ChatGPT 4.6 Sol" is not a verified API model ID and is not
# silently substituted. Set an exact Responses API model available to you.
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# User-requested identifier. Verify that this exact model is available to the
# deployment account before use; registry Ready status does not authenticate it.
ANTHROPIC_MODEL=claude-fable-5

GEMINI_API_KEY=
# Requested "Gemini Pro 3.6+" is not a verified API model ID and is not
# silently substituted. Set an exact generateContent model available to you.
GEMINI_MODEL=

# Optional OpenTelemetry Collector base endpoint. Do not include credentials,
# query strings, or fragments. Keep auth material in standard OTLP header env.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
DEPLOYMENT_ENV=development
